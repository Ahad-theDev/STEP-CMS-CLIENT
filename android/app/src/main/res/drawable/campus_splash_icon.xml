<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the entire square inside Android 12's safe area, avoiding circular clipping. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape><solid android:color="@android:color/transparent" /></shape>
    </item>
    <item android:width="128dp" android:height="128dp" android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="315" android:startColor="#FFF4DF" android:endColor="#FFDFAC" />
            <stroke android:width="1dp" android:color="#80F18432" />
        </shape>
    </item>
    <item android:width="106dp" android:height="106dp" android:gravity="center">
        <bitmap android:src="@drawable/campus_logo" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
