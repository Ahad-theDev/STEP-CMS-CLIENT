<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CampusLaunchBase" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/campus_splash_background</item>
        <item name="android:navigationBarColor">@color/campus_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="LaunchTheme" parent="CampusLaunchBase" />
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/campus_window_background</item>
    </style>
</resources>
