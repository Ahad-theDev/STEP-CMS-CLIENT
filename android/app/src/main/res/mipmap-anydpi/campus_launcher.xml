<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="48dp" android:height="48dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="315" android:startColor="#153D79" android:endColor="#2867A9" />
        </shape>
    </item>
    <item android:width="36dp" android:height="24dp" android:gravity="center">
        <bitmap android:src="@drawable/campus_logo" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
